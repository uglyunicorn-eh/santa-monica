{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gnomik-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Logs and traces: kept in Workers Logs and exported to Better Stack (source "gnomik-api") through the
  // betterstack-logs / betterstack-traces OpenTelemetry destinations set up in the Cloudflare dashboard.
  // Query strings are left out of request URLs in logs and traces: party routes carry the party code there (?code=),
  // and a code lets anyone into a party without a secret phrase.
  "observability": {
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": true, "persist": true, "head_sampling_rate": 1, "destinations": ["betterstack-logs"] },
    "traces": { "enabled": true, "persist": true, "head_sampling_rate": 1, "destinations": ["betterstack-traces"] }
  },
  "assets": { "directory": "./public", "binding": "ASSETS" },

  // Production: api.gnomik.me, deployed on every merge to main.
  "routes": [{ "pattern": "api.gnomik.me", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "PUBLIC_URL": "https://api.gnomik.me",
    "FRONTEND_URL": "https://gnomik.me",
    "ALLOWED_ORIGINS": "https://gnomik.me,https://*.santa-57a.pages.dev"
  },
  "durable_objects": {
    "bindings": [
      { "name": "PARTY", "class_name": "PartyDO" },
      { "name": "USER", "class_name": "UserDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PartyDO", "UserDO"] }
  ],
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["info@gnomik.me"] }
  ],
  "ratelimits": [
    { "name": "ENTER_RATE_LIMIT_IP", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "ENTER_RATE_LIMIT_EMAIL", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
    // Party codes are the key to a party without a secret phrase, so looking them up and joining are limited too.
    { "name": "PARTY_LOOKUP_RATE_LIMIT_IP", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    // Old 5-letter codes (about 1.2·10^7 of them) are far easier to guess than 8-letter ones, so trying them is slower.
    { "name": "LEGACY_CODE_LOOKUP_RATE_LIMIT_IP", "namespace_id": "1005", "simple": { "limit": 10, "period": 60 } },
    { "name": "JOIN_RATE_LIMIT_USER", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } }
  ],

  "env": {
    // Pull request previews run as Worker Previews of one fixed Worker, gnomik-api-preview:
    // `wrangler preview --env preview --name pr-<n>`, deleted when the PR closes. Each Preview gets its own empty
    // Durable Objects (never production data) and its own URL. Previews don't inherit settings, so everything they
    // need is in the `previews` block below. PUBLIC_URL is passed with --var by the workflow.
    "preview": {
      // The fixed Worker itself serves nothing: it is only the home of the Previews, deployed once so a Cloudflare
      // API token can be scoped to it. Previews keep their own URLs.
      "routes": [],
      "workers_dev": false,
      "preview_urls": true,
      "vars": {
        "PUBLIC_URL": "https://gnomik-api-preview.uglyunicorn.workers.dev",
        "FRONTEND_URL": "http://localhost:4321",
        "ALLOWED_ORIGINS": "https://gnomik.me,https://*.santa-57a.pages.dev,http://localhost:4321,http://localhost:4322,http://localhost:4323"
      },
      "durable_objects": {
        "bindings": [
          { "name": "PARTY", "class_name": "PartyDO" },
          { "name": "USER", "class_name": "UserDO" }
        ]
      },
      "send_email": [
        { "name": "EMAIL", "allowed_sender_addresses": ["info@gnomik.me"] }
      ],
      "ratelimits": [
        { "name": "ENTER_RATE_LIMIT_IP", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
        { "name": "ENTER_RATE_LIMIT_EMAIL", "namespace_id": "2002", "simple": { "limit": 3, "period": 60 } },
        { "name": "PARTY_LOOKUP_RATE_LIMIT_IP", "namespace_id": "2003", "simple": { "limit": 60, "period": 60 } },
        { "name": "LEGACY_CODE_LOOKUP_RATE_LIMIT_IP", "namespace_id": "2005", "simple": { "limit": 10, "period": 60 } },
        { "name": "JOIN_RATE_LIMIT_USER", "namespace_id": "2004", "simple": { "limit": 10, "period": 60 } }
      ],
      // Logs stay in Workers Logs only, so test traffic stays out of Better Stack.
      "observability": {
        "redact_query_string": true,
        "logs": { "enabled": true, "invocation_logs": true, "persist": true },
        "traces": { "enabled": false }
      },
      "previews": {
        "vars": {
          // Previews are public, so they email only these (comma-separated addresses and @domains). Add yours to test.
          "EMAIL_ALLOWLIST": "@uglyunicorn.ca,@gnomik.me",
          "FRONTEND_URL": "http://localhost:4321",
          "ALLOWED_ORIGINS": "https://gnomik.me,https://*.santa-57a.pages.dev,http://localhost:4321,http://localhost:4322,http://localhost:4323"
        },
        // The code reads these from env, so Previews need them declared (each Preview still gets its own storage).
        "durable_objects": {
          "bindings": [
            { "name": "PARTY", "class_name": "PartyDO" },
            { "name": "USER", "class_name": "UserDO" }
          ]
        },
        "send_email": [
          { "name": "EMAIL", "allowed_sender_addresses": ["info@gnomik.me"] }
        ],
        "ratelimits": [
          { "name": "ENTER_RATE_LIMIT_IP", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
          { "name": "ENTER_RATE_LIMIT_EMAIL", "namespace_id": "2002", "simple": { "limit": 3, "period": 60 } },
          { "name": "PARTY_LOOKUP_RATE_LIMIT_IP", "namespace_id": "2003", "simple": { "limit": 60, "period": 60 } },
          { "name": "LEGACY_CODE_LOOKUP_RATE_LIMIT_IP", "namespace_id": "2005", "simple": { "limit": 10, "period": 60 } },
          { "name": "JOIN_RATE_LIMIT_USER", "namespace_id": "2004", "simple": { "limit": 10, "period": 60 } }
        ],
        "observability": {
          "redact_query_string": true,
          "logs": { "enabled": true, "invocation_logs": true, "persist": true },
          "traces": { "enabled": false }
        }
      }
    }
  }
}
