{
  "name": "santa-monica",
  "description": "Backyard of the Anonymous Ded Morozes",
  "version": "5.0.0-rc",
  "license": "MIT",
  "private": true,
  "type": "module",
  "author": "Ugly Unicorn <info@uglyunicorn.ca>",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types --include-runtime=false",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "smoke": "node scripts/smoke.ts",
    "typecheck": "tsc --noEmit && tsc -p scripts"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:uglyunicorn-eh/santa-monica.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/uglyunicorn-eh/santa-monica/issues"
  },
  "homepage": "https://github.com/uglyunicorn-eh/santa-monica",
  "dependencies": {
    "hono": "^4.13.14",
    "jose": "^6.2.13",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.8",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-istanbul": "^5.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "overrides": {
    "undici": "7.30.1",
    "zod": "4.6.6"
  }
}
