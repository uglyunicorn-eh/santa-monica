{
  "name": "santa-monica",
  "description": "Backyard of the Anonymous Ded Morozes",
  "version": "4.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "author": "Ugly Unicorn <info@uglyunicorn.ca>",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types --include-runtime=false",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "smoke": "node scripts/smoke.ts",
    "typecheck": "tsc --noEmit && tsc -p scripts",
    "export-mongo": "node --env-file=.env.local scripts/export-mongo.ts",
    "import": "node scripts/import.ts"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:uglyunicorn-eh/santa-monica.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/uglyunicorn-eh/santa-monica/issues"
  },
  "homepage": "https://github.com/uglyunicorn-eh/santa-monica",
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@graphql-tools/schema": "^11.0.6",
    "graphql": "^16.14.2",
    "graphql-middleware": "^6.1.35",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/node": "^22.19.0",
    "@vitest/coverage-istanbul": "^4.1.12",
    "mongodb": "^6.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
